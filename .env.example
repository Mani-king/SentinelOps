# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# HINDSIGHT_API_KEY: API token for Hindsight Cloud (https://hindsight.vectorize.io)
# Provide in environment or server secrets for persistent organizational memory.
HINDSIGHT_API_KEY="MY_HINDSIGHT_API_KEY"

# HINDSIGHT_BASE_URL: Hindsight API base URL (Default: https://api.hindsight.vectorize.io)
HINDSIGHT_BASE_URL="https://api.hindsight.vectorize.io"

# HINDSIGHT_BANK_ID: Isolated Hindsight memory bank name for SOC memory
HINDSIGHT_BANK_ID="sentinelops-soc-prod"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
